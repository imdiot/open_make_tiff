{
  "name": "open-make-tiff",
  "version": "0.1.2",
  "dependencies": [
    {
      "name": "libraw",
      "features": [
        "6by9rpi",
        "demosaic-pack-gpl2",
        "demosaic-pack-gpl3",
        "dng-lossy",
        "dngsdk",
        "rawspeed",
        "rawspeed3",
        "x3ftools"
      ]
    },
    {
      "name": "tiff",
      "features": [
        "cxx",
        "jpeg",
        "lerc",
        "libdeflate",
        "lzma",
        "webp",
        "zip",
        "zstd"
      ]
    }
  ]
}
